{
  "name": "hazina-escrow",
  "version": "1.0.0",
  "description": "Hazina Data Escrow — Web3 data marketplace on Stellar",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix packages/hazina-mcp",
    "dev": "concurrently --names \"API,UI\" --prefix-colors \"yellow,cyan\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:mcp": "npm run dev --prefix packages/hazina-mcp",
    "build": "npm run build --prefix backend && npm run build --prefix frontend && npm run build --prefix packages/hazina-mcp",
    "prepare": "husky",
    "format": "prettier --write \"backend/src/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\" \"packages/hazina-mcp/src/**/*.ts\"",
    "format:check": "prettier --check \"backend/src/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\" \"packages/hazina-mcp/src/**/*.ts\"",
    "lint": "eslint \"backend/src/**/*.{ts,tsx}\" \"frontend/src/**/*.{ts,tsx}\" \"packages/hazina-mcp/src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format:all": "prettier --check .",
    "format:write": "prettier --write .",
    "contracts:check": "./scripts/contracts/checks.sh",
    "contracts:formal": "./scripts/contracts/formal-checks.sh",
    "devnet": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/devnet/provision.ts",
    "devnet:reset": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/devnet/reset.ts",
    "devnet:status": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/devnet/status.ts",
    "devnet:down": "docker compose -f docker-compose.devnet.yml -p hazina-devnet down -v --remove-orphans",
    "devnet:logs": "docker compose -f docker-compose.devnet.yml -p hazina-devnet logs -f stellar-devnet",
    "test:devnet": "vitest run --config vitest.devnet.config.ts",
    "e2e:chain": "vitest run --config vitest.chain.config.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@stellar/stellar-sdk": "^17.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "backend/src/**/*.{ts,tsx}": [
      "npx prettier --write",
      "npx eslint --max-warnings=0"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "npx prettier --write",
      "npx eslint --max-warnings=0"
    ],
    "packages/hazina-mcp/src/**/*.ts": [
      "npx prettier --write",
      "npx eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@openfeature/core": "^1.11.0",
    "@openfeature/server-sdk": "^1.22.0",
    "@opentelemetry/core": "^2.8.0",
    "dd-trace": "^5.100.0",
    "esbuild": "^0.25.0",
    "uuid": "^11.1.1"
  }
}
