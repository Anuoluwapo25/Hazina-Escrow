# ─────────────────────────────────────────────
# Hazina Escrow — Backend Environment Variables
# Copy this file to backend/.env and fill in values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=3001
# The URL of the running frontend (used for CORS).
FRONTEND_URL=http://localhost:5173

# ── API Keys ──────────────────────────────────
# Legacy shared key for seller writes. Now OPTIONAL: sellers authenticate with
# SEP-10 wallet challenges when AUTH_MODE=sep10/both (see below).
# If you set VITE_API_KEY in frontend/.env, it must match this value.
API_KEY=your_dataset_creation_key
# Used for administrative actions like backups
ADMIN_API_KEY=your_admin_key
# Used for signing seller dashboard JWT tokens
SELLER_JWT_SECRET=your_jwt_secret_here
# Shared secret for verifying incoming payment webhooks
PAYMENT_WEBHOOK_SECRET=your_webhook_verification_secret_here

# ── Seller auth mode (SEP-10, #586) ───────────
# 'legacy' (default), 'sep10', or 'both'. See backend/.env.example for the
# full set of WEB_AUTH_* / SEP10_* variables.
AUTH_MODE=legacy

# ── Database ───────────────────────────────────
# SQLite (default): file:./sqlite.db
DATABASE_URL=file:./sqlite.db

# ── Anthropic / Claude ─────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...
# Default Claude model for summaries and health checks.
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Stellar Network ────────────────────────────
# "testnet" or "mainnet" — defaults to testnet if unset.
STELLAR_NETWORK=testnet

# ── Escrow & Agent ─────────────────────────────
# The Stellar G... address that receives buyer payments (legacy custodial demo path).
ESCROW_WALLET=G...
# The secret key (S...) for the autonomous Research Agent's wallet.
AGENT_WALLET_SECRET=S...

# Non-custodial escrow: address (C...) of the deployed Soroban escrow contract.
# When set, buyers lock funds into the contract from their own wallet and the
# contract performs the 95/5 split on-chain. Leave unset for custodial demo mode.
ESCROW_CONTRACT_ID=
# Soroban Asset Contract (SAC) addresses used by the escrow contract's lock().
USDC_SAC_ADDRESS=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
XLM_SAC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ── USDC Asset ─────────────────────────────────
# Testnet USDC issuer  : GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet USDC issuer  : GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── Platform Fee ───────────────────────────────
# Fraction of every sale the platform keeps, in [0, 1] (0.05 = 5%).
PLATFORM_FEE_RATE=0.05

# ── Dataset Snapshots (history) ────────────────
# Set to "false" to disable the scheduled retention/downsampling job.
SNAPSHOT_COMPACTION_ENABLED=true
# How often compaction runs, in ms (minimum 60000; default 6 hours).
SNAPSHOT_COMPACTION_INTERVAL_MS=21600000
# Set to "false" to skip the idempotent startup backfill that gives existing
# datasets an opening snapshot.
SNAPSHOT_BACKFILL_ON_START=true
