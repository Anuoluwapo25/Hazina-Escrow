PORT=3001
# The URL of the running frontend (used for CORS).
# Required in production. Use the deployed frontend origin, not localhost.
FRONTEND_URL=http://localhost:5173

# API Authentication
# Protects seller write operations (POST /api/datasets, webhook management).
# Generate with: openssl rand -hex 32
API_KEY=your_api_key_here

# Protects admin-only endpoints (backup list, create, restore).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_RESEARCH_MODEL=claude-3-5-haiku-20241022

# Stellar USDC issuer — required to prevent XLM or fake-USDC substitution attacks
# Testnet:  GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet:  GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Stellar Escrow Wallet (testnet) — receives 1 USDC from humans
ESCROW_WALLET=GBVNKDPGVZGFKGRHDUBSZ5V7PXY6PJRFYF5RYVBKAHV3BUXHQWCFXBZ
ESCROW_SECRET=your_escrow_wallet_secret_here

# ── Non-custodial escrow (Soroban contract) ─────────────────────────────────
# Address (C…) of the deployed Hazina escrow contract. When set, buyers lock
# funds INTO the contract from their own wallet and the contract performs the
# 95/5 split on-chain — no funds route through a Hazina-controlled wallet.
# Leave UNSET to fall back to the legacy custodial demo path.
ESCROW_CONTRACT_ID=

# Soroban Asset Contract (SAC) addresses — the token *contract* the escrow
# contract's lock(token, …) expects (not the classic issuer account).
# Testnet USDC SAC / native XLM SAC defaults are baked in; override if needed.
USDC_SAC_ADDRESS=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
XLM_SAC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# EURC_SAC_ADDRESS=

# Soroban RPC endpoint (defaults to the public testnet RPC when unset)
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Passkey smart-wallet checkout (#587) ────────────────────────────────────
# Launchtube is the paymaster that submits a passkey buyer's deploy/payment
# transactions so they never need testnet XLM. Leave LAUNCHTUBE_JWT unset to
# disable passkey checkout (its endpoints then return 503) — every other
# wallet path (Freighter, Albedo, demo mode) is unaffected.
# Generate a testnet token at https://testnet.launchtube.xyz/gen.
LAUNCHTUBE_URL=https://testnet.launchtube.xyz
LAUNCHTUBE_JWT=

# Hex WASM hash of the deployed smart-wallet contract PasskeyKit deploys new
# wallets from. Mirrored to the frontend as VITE_PASSKEY_WALLET_WASM_HASH —
# it identifies contract code, not a secret.
PASSKEY_WALLET_WASM_HASH=

# Passkey deploy/submit rate limit — keep tight, each request can spend
# Hazina's Launchtube fee budget (default: 5 requests / RATE_LIMIT_WINDOW_MS)
RATE_LIMIT_PASSKEY_MAX=5

# Platform fee percentage (5%)
PLATFORM_FEE=0.05

# Hazina Research Agent Wallet (testnet) — must be funded with USDC to pay sellers
# Generate a new testnet keypair: https://laboratory.stellar.org/#account-creator?network=test
# Fund it at: https://friendbot.stellar.org/?addr=YOUR_PUBLIC_KEY
# Then add USDC trustline and fund via testnet USDC faucet
AGENT_WALLET_SECRET=your_agent_wallet_secret_here

# Agent fee in USDC — flat fee per research job (default: 1)
AGENT_FEE_USDC=1

# ── Claimable balance payout fallback (#589) ────────────────────────────────
# When a seller's wallet can't receive a direct payout (no trustline, unfunded
# account, ...), the payout settles into a Stellar claimable balance instead
# of the retry/DLQ. AGENT_WALLET_SECRET above also acts as the sponsor/treasury
# that funds and reclaims these — no separate secret needed.
# Seconds after which the treasury's reclaim claimant becomes valid, so an
# unclaimed balance can be swept back instead of staying stranded forever.
# Default: 15552000 (180 days).
CLAIM_RECLAIM_SECONDS=15552000

# Database Backup Configuration
# Enable/disable automated backups (default: true)
BACKUP_ENABLED=true

# Directory where backups are stored (default: backend/backups)
BACKUP_DIR=./backups

# Maximum number of backups to retain (default: 30)
BACKUP_MAX_BACKUPS=30

# Backup schedule in cron format or simple interval
# Cron examples:
#   "0 0 * * *"   = Daily at midnight
#   "0 */6 * * *" = Every 6 hours
#   "0 0 * * 0"   = Weekly on Sunday
#   "*/30 * * * *" = Every 30 minutes
# Simple interval examples:
#   "1h"  = Every hour
#   "30m" = Every 30 minutes
#   "1d"  = Every day
BACKUP_CRON_SCHEDULE=0 0 * * *

# Sentry Error Monitoring
# Leave blank to disable Sentry (no-op when unset)
SENTRY_DSN=
# Fraction of transactions to sample for performance tracing (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release identifier sent with every event (defaults to package version)
SENTRY_RELEASE=

# Optional seller email notifications (disabled when RESEND_API_KEY is unset)
RESEND_API_KEY=
# Must use a domain verified in Resend for production delivery
RESEND_FROM_EMAIL=

# ── Sentinel (escrow contract watcher) — see docs/MONITORING.md ────────────
# Arms the in-process watcher started from main.ts. Leave false there when
# running Sentinel as its own container instead (docker-compose's `sentinel`
# service) so the watcher doesn't run twice.
SENTINEL_ENABLED=false
# Port the standalone Sentinel container listens on.
SENTINEL_PORT=3002
# Ledger to start ingestion from when no cursor has been persisted yet.
SENTINEL_START_LEDGER=0
# Events fetched per getEvents page.
SENTINEL_PAGE_LIMIT=100
# How often (ms) the watcher fetches a new event page and re-runs the timer checks.
SENTINEL_TICK_MS=15000
# Ledger-stall threshold (seconds) before a high alert fires.
SENTINEL_STALL_SECONDS=120
# Re-notification window (seconds) for a still-open alert of the same (invariant, escrow).
SENTINEL_ALERT_SUPPRESS_SECONDS=3600
# Cap on escrow ids read per solvency/expiry sweep.
SENTINEL_SOLVENCY_MAX_SCAN=5000
# Band a fee change must stay inside before fee_band fires (matches the contract's MAX_FEE_BPS by default).
SENTINEL_FEE_BAND_MIN_BPS=0
SENTINEL_FEE_BAND_MAX_BPS=2000
# Slack/Discord-compatible incoming webhook — every alert is posted here.
SENTINEL_ALERT_WEBHOOK_URL=
# Recipient for critical-only email alerts (needs RESEND_API_KEY above).
SENTINEL_ALERT_EMAIL=

# ── Receipt anchoring (verifiable delivery receipts) ─────────────────────────
# Periodically anchors delivery-receipt hashes on-chain as MEMO_HASH memos.
# Set to false to disable the background sweep worker (default: true).
RECEIPT_ANCHOR_ENABLED=true
# How often the sweep runs (ms). Default: 60000 (1 minute).
RECEIPT_ANCHOR_INTERVAL_MS=60000
# How many batched-mode receipts to include per batch (default: 64).
RECEIPT_ANCHOR_BATCH_SIZE=64
