# ─────────────────────────────────────────────
# Hazina Escrow — Frontend Environment Variables
# Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# Base URL of the backend API (e.g. http://localhost:3001)
# Required. Omission causes a startup error.
VITE_API_URL=http://localhost:3001

# API Key used for backend authentication (e.g. for creating datasets)
# Now OPTIONAL — sellers authenticate with SEP-10 wallet challenges when the
# backend runs AUTH_MODE=sep10/both (#586). Only set this for legacy (AUTH_MODE
# unset) deployments; it must then match the backend API_KEY.
VITE_API_KEY=your_api_key_here

# Optional: enable the Query Modal demo-mode checkbox for local/admin testing only.
# Leave unset or set to false in production builds.
VITE_ENABLE_DEMO_MODE=false

# ── Passkey smart-wallet checkout (#587) ────────────────────────────────────
# Hex WASM hash of the deployed smart-wallet contract (matches the backend's
# PASSKEY_WALLET_WASM_HASH — this is a public code identifier, not a secret).
# Leave unset to hide passkey checkout entirely.
VITE_PASSKEY_WALLET_WASM_HASH=

# Optional: Soroban RPC endpoint override (defaults to the public testnet RPC).
# VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
