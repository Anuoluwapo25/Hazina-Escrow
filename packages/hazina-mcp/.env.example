# ─────────────────────────────────────────────
# Hazina MCP Server — Environment Variables
# Copy this file to .env and fill in values, or set these directly in your
# MCP client's config (see README.md for a Claude Desktop / Claude Code block).
# ─────────────────────────────────────────────

# Base URL of the Hazina backend REST API.
HAZINA_API_URL=http://localhost:3001

# Bearer token for the backend's payments endpoints. Must match the backend's API_KEY.
HAZINA_API_KEY=

# Stellar secret key (S...) this server signs real purchases with.
# Required for real (non-demo) purchases; leave unset in demo mode.
HAZINA_WALLET_SECRET=

# Dry-run mode: purchase_dataset never signs a real transaction. 1/true to enable.
HAZINA_MCP_DEMO=1

# Spend limits enforced server-side before any payment is signed, in USDC.
HAZINA_MCP_MAX_SPEND_PER_CALL=1
HAZINA_MCP_MAX_SPEND_PER_SESSION=5

# Transport: stdio (default, what Claude Desktop/Code expect) or http.
HAZINA_MCP_TRANSPORT=stdio
HAZINA_MCP_HTTP_PORT=8420
